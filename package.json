{
  "name": "universal-tech-store",
  "version": "1.0.0",
  "description": "Интернет-магазин техники: витрина, корзина, отзывы с модерацией, панель администратора, онлайн-оплата и заявки в Telegram. Один процесс — один магазин, без внешних зависимостей.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "ui:toast": "node scripts/build-smoothui-toast.js",
    "ui:toast:verify": "node scripts/build-smoothui-toast.js --verify",
    "css:critical": "node scripts/build-critical-css.js",
    "css:critical:verify": "node scripts/build-critical-css.js --verify",
    "reset:admin": "node scripts/reset-admin-password.js",
    "reviews:demo": "node scripts/demo-reviews.js --apply",
    "reviews:demo:remove": "node scripts/demo-reviews.js --remove",
    "seed": "node seed.js",
    "seed:all": "node seed.js --all"
  },
  "dependencies": {},
  "engines": {
    "node": ">=18"
  }
}
