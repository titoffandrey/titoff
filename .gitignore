# выгрузка фотографий с buy-страниц (scripts/fetch-apple-watch-photos.js):
# сотни мегабайт кадров, которые заливаются в каталог руками через панель
apple-photos/

# рабочие каталоги сессий: сборка отчётов, документов для банка и прочие
