  "header": "<header class=\"sticky top-0 z-99999 flex w-full border-gray-200 bg-white xl:border-b dark:border-gray-800 dark:bg-gray-900 ta ta-header\" data-tailadmin-component=\"header\">\n  <div class=\"flex grow flex-col items-center justify-between xl:flex-row xl:px-6\">\n    <div class=\"flex w-full items-center justify-between gap-2 border-b border-gray-200 px-3 py-3 sm:gap-4 lg:py-4 xl:justify-normal xl:border-b-0 xl:px-0 dark:border-gray-800 ta-header-row\">@@CONTENT@@</div>\n\n    <div class=\"shadow-theme-md w-full items-center justify-between gap-4 px-5 py-4 xl:flex xl:justify-end xl:px-0 xl:shadow-none ta-header-actions\">@@ACTIONS@@</div>\n  </div>\n</header>",
