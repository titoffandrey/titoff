  "signin": "<div class=\"relative z-1 bg-white p-6 sm:p-0 dark:bg-gray-900 ta ta-signin\" data-tailadmin-component=\"signin\">\n      <div class=\"relative flex h-screen w-full flex-col justify-center sm:p-0 lg:flex-row dark:bg-gray-900\">\n        \n        <div class=\"flex w-full flex-1 flex-col lg:w-1/2\">\n          <div class=\"mx-auto w-full max-w-md pt-10\">\n            <a href=\"/\" class=\"inline-flex items-center text-sm text-gray-500 transition-colors hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300\"><svg class=\"stroke-current rtl:scale-x-[-1]\" xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\">\n                <path d=\"M12.7083 5L7.5 10.2083L12.7083 15.4167\" stroke=\"\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n              </svg>На витрину</a>\n          </div>\n          <div class=\"mx-auto flex w-full max-w-md flex-1 flex-col justify-center\">\n            <div>\n              <div class=\"mb-5 sm:mb-8\">\n                <h1 class=\"text-title-sm sm:text-title-md mb-2 font-semibold text-gray-800 dark:text-white/90\">Вход в панель</h1>\n                <p class=\"text-sm text-gray-500 dark:text-gray-400\">@@STORE@@</p>\n              </div>\n              <div>\n                \n                \n                <form method=\"post\" action=\"/admin/login\">@@ERROR@@\n                  <div class=\"space-y-5\">\n                    \n                    <div>\n                      <label class=\"mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400\" for=\"admin-login\">Логин</label>\n                      <input type=\"text\" id=\"admin-login\" name=\"username\" placeholder=\"Логин\" class=\"dark:bg-dark-900 shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30\" autocomplete=\"username\" required=\"\" autofocus=\"\">\n                    </div>\n                    \n                    <div>\n                      <label class=\"mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400\" for=\"admin-password\">Пароль</label>\n                      <div class=\"relative\">\n                        <input placeholder=\"Пароль\" class=\"dark:bg-dark-900 shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent py-2.5 ps-4 pe-11 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30\" type=\"password\" id=\"admin-password\" name=\"password\" autocomplete=\"current-password\" required=\"\">\n                        \n                      </div>\n                    </div>\n                    \n                    \n                    \n                    <div>\n                      <button class=\"bg-brand-500 shadow-theme-xs hover:bg-brand-600 flex w-full items-center justify-center rounded-lg px-4 py-3 text-sm font-medium text-white transition\" type=\"submit\">Войти</button>\n                    </div>\n                  </div>\n                </form>\n                \n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"bg-brand-950 relative hidden h-full w-full items-center lg:grid lg:w-1/2 dark:bg-white/5\">\n          <div class=\"z-1 flex items-center justify-center\">\n            \n            <div class=\"absolute top-0 right-0 -z-1 w-full max-w-[250px] xl:max-w-[450px] rtl:right-auto rtl:left-0 rtl:-scale-x-100\">\n  <img src=\"/static/tailadmin-grid.svg\" alt=\"\">\n</div>\n<div class=\"absolute bottom-0 left-0 -z-1 w-full max-w-[250px]