  "orderRow": "<tr id=\"@@ID@@\" data-live-key=\"@@ID@@\">\n          <td class=\"px-6 py-3 whitespace-nowrap first:pl-0 rtl:first:pr-0 rtl:first:pl-6\">@@PRODUCT@@</td>\n          <td class=\"px-6 py-3 whitespace-nowrap first:pl-0 rtl:first:pr-0 rtl:first:pl-6\">@@CUSTOMER@@</td>\n          <td class=\"px-6 py-3 whitespace-nowrap first:pl-0 rtl:first:pr-0 rtl:first:pl-6\">@@TOTAL@@</td>\n          <td class=\"px-6 py-3 whitespace-nowrap first:pl-0 rtl:first:pr-0 rtl:first:pl-6\">@@STATUS@@</td>\n        </tr>",
  "ordersTable": "<div class=\"ta custom-scrollbar max-w-full overflow-x-auto\"><table class=\"min-w-full ta-orders-table\">\n      \n      <thead class=\"border-y border-gray-100 dark:border-gray-800\">\n        <tr>\n          <th class=\"px-6 py-3 whitespace-nowrap first:pl-0 rtl:first:pr-0 rtl:first:pl-6\">\n            <div class=\"flex items-center\">\n              <p class=\"text-theme-xs font-medium text-gray-500 dark:text-gray-400\">Товар / заказ</p>\n            </div>\n          </th>\n          <th class=\"px-6 py-3 whitespace-nowrap\">\n            <div class=\"flex items-center\">\n              <p class=\"text-theme-xs font-medium text-gray-500 dark:text-gray-400\">Покупатель</p>\n            </div>\n          </th>\n          <th class=\"px-6 py-3 whitespace-nowrap\">\n            <div class=\"flex items-center\">\n              <p class=\"text-theme-xs font-medium text-gray-500 dark:text-gray-400\">Сумма</p>\n            </div>\n          </th>\n          <th class=\"px-6 py-3 whitespace-nowrap\">\n            <div class=\"flex items-center\">\n              <p class=\"text-theme-xs font-medium text-gray-500 dark:text-gray-400\">Статус</p>\n            </div>\n          </th>\n        <th class=\"px-6 py-3 text-theme-xs font-medium text-gray-500 dark:text-gray-400\">Действия</th></tr>\n      </thead>\n      \n\n      \n      <tbody class=\"divide-y divide-gray-100 py-3 dark:divide-gray-800\">@@ROWS@@</tbody>\n\n      \n    </table></div>",
  "orderFullRow": "<tr id=\"@@ID@@\" data-live-key=\"@@ID@@\" class=\"@@ROWCLASS@@\">\n          <td class=\"px-6 py-3 whitespace-nowrap first:pl-0 rtl:first:pr-0 rtl:first:pl-6\">@@PRODUCT@@</td>\n          <td class=\"px-6 py-3 whitespace-nowrap first:pl-0 rtl:first:pr-0 rtl:first:pl-6\">@@CUSTOMER@@</td>\n          <td class=\"px-6 py-3 whitespace-nowrap first:pl-0 rtl:first:pr-0 rtl:first:pl-6\">@@TOTAL@@</td>\n          <td class=\"px-6 py-3 whitespace-nowrap first:pl-0 rtl:first:pr-0 rtl:first:pl-6\">@@STATUS@@</td>\n        <td class=\"px-6 py-3 text-sm\">@@ACTIONS@@</td></tr>",
  "countryRow": "<div class=\"flex items-center justify-between\">\n      <div class=\"flex items-center gap-3\">\n        <div class=\"w-full max-w-8 items-center rounded-full\">\n          <span class=\"ta-country-flag\" aria-hidden=\"true\">@@FLAG@@</span>\n        </div>\n        <div>\n          <p class=\"text-theme-sm font-semibold text-gray-800 dark:text-white/90\">@@NAME@@</p>\n          <span class=\"text-theme-xs block text-gray-500 dark:text-gray-400\">@@COUNT@@</span>\n        </div>\n      </div>\n\n      <div class=\"flex w-full max-w-35 items-center gap-3\">\n        <div class=\"relative block h-2 w-full max-w-25 rounded-sm bg-gray-200 dark:bg-gray-800\">\n          <div class=\"bg-brand-500 absolute top-0 left-0 flex h-full items-center justify-center rounded-sm text-xs font-medium text-white rtl:right-0 rtl:left-auto\" style=\"width:@@PERCENT@@%\"></div>\n        </div>\n        <p class=\"text-theme-sm font-medium text-gray-800 dark:text-white/90\">@@PERCENT@@%</p>\n      </div>\n    </div>",
  "map": "<div class=\"rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 dark:border-gray-800 dark:bg-white/3 ta ta-map-card\" data-tailadmin-component=\"map-01\">\n  <div class=\"flex justify-between\">\n    <div>\n      <h3 class=\"text-lg font-semibold text-gray-800 dark:text-white/90\">Посетители по странам</h3>\n      <p class=\"text-theme-sm mt-1 text-gray-500 dark:text-gray-400\">География посещений сегодня</p>\n    </div>\n\n    \n  </div>\n  <div class=\"border-gary-200 my-6 overflow-hidden rounded-2xl border bg-gray-50 px-4 py-6 sm:px-6 dark:border-gray-800 dark:bg-gray-900\">\n    <div id=\"visitors-map\" class=\"mapOne map-btn 2xsm:w-76.75 xsm:w-89.5 -mx-4 -my-6 h-53 w-63 sm:-mx-6 md:w-167 lg:w-158.5 xl:w-98.25 2xl:w-138.5\" data-ta-map=\"\" data-ta-config=\"@@DATA@@\" data-live-key=\"visitors-map\" aria-label=\"Карта стран посетителей\"><div data-ta-map-canvas=\"\" data-live-key=\"visitors-map-canvas\"></div></div>\n  </div>\n\n  <div class=\"space-y-5\">@@COUNTRIES@@</div>\n</div>",
