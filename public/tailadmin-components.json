  "areaChart": "<div class=\"rounded-2xl border border-gray-200 bg-white px-5 pt-5 pb-5 sm:px-6 sm:pt-6 dark:border-gray-800 dark:bg-white/3 ta ta-chart-card\" data-tailadmin-component=\"chart-03\">\n  <div class=\"mb-6 flex flex-col gap-5 sm:flex-row sm:justify-between\">\n    <div class=\"w-full\">\n      <h3 class=\"text-lg font-semibold text-gray-800 dark:text-white/90\">@@TITLE@@</h3>\n      <p class=\"text-theme-sm mt-1 text-gray-500 dark:text-gray-400\">@@SUBTITLE@@</p>\n    </div>\n\n    <div class=\"flex w-full items-start gap-3 sm:justify-end\">@@CONTROLS@@</div>\n  </div>\n  <div class=\"custom-scrollbar max-w-full overflow-x-auto\">\n    <div id=\"@@ID@@\" class=\"-ml-4 min-w-175 pl-2 xl:min-w-full rtl:-mr-4 rtl:ml-0 rtl:pr-2 rtl:pl-0\" data-ta-chart=\"area\" data-ta-config=\"@@DATA@@\" data-live-key=\"@@ID@@\"><div class=\"ta-chart-canvas\" data-ta-chart-canvas=\"\" data-live-key=\"@@ID@@-canvas\"></div><div class=\"ta-chart-fallback\">@@FALLBACK@@</div></div>\n  </div>\n</div>",
