  "tableFrame": "<div class=\"overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/3 ta ta-table-frame\">\n  <div class=\"custom-scrollbar max-w-full overflow-x-auto\">\n    @@TABLE@@\n  </div>\n</div>",
