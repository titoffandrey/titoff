  "radialChart": "<div class=\"rounded-2xl border border-gray-200 bg-gray-100 dark:border-gray-800 dark:bg-white/3 ta ta-chart-card\" data-tailadmin-component=\"chart-02\">\n  <div class=\"shadow-default rounded-2xl bg-white px-5 pt-5 pb-11 sm:px-6 sm:pt-6 dark:bg-gray-900\">\n    <div class=\"flex justify-between\">\n      <div>\n        <h3 class=\"text-lg font-semibold text-gray-800 dark:text-white/90\">@@TITLE@@</h3>\n        <p class=\"text-theme-sm mt-1 text-gray-500 dark:text-gray-400\">@@SUBTITLE@@</p>\n      </div>\n      \n    </div>\n    <div class=\"relative max-h-48.75\">\n      <div id=\"@@ID@@\" class=\"h-full\" data-ta-chart=\"radialBar\" data-ta-config=\"@@DATA@@\" data-live-key=\"@@ID@@\"><div class=\"ta-chart-canvas\" data-ta-chart-canvas=\"\" data-live-key=\"@@ID@@-canvas\"></div><div class=\"ta-chart-fallback\">@@FALLBACK@@</div></div>\n      \n    </div>\n    <p class=\"mx-auto mt-1.5 w-full max-w-95 text-center text-sm text-gray-500 sm:text-base dark:text-gray-400\">@@DESCRIPTION@@</p>\n  </div>\n\n  <div class=\"flex items-center justify-center gap-5 px-6 py-3.5 sm:gap-8 sm:py-5\">\n    <div>\n      <p class=\"text-theme-xs mb-1 text-center text-gray-500 sm:text-sm dark:text-gray-400\">Заказов</p>\n      <p class=\"flex items-center justify-center gap-1 text-base font-semibold text-gray-800 sm:text-lg dark:text-white/90\">@@COUNT@@</p>\n    </div>\n\n    <div class=\"h-7 w-px bg-gray-200 dark:bg-gray-800\"></div>\n\n    <div>\n      <p class=\"text-theme-xs mb-1 text-center text-gray-500 sm:text-sm dark:text-gray-400\">Оплачено</p>\n      <p class=\"flex items-center justify-center gap-1 text-base font-semibold text-gray-800 sm:text-lg dark:text-white/90\">@@PAID@@</p>\n    </div>\n\n    <div class=\"h-7 w-px bg-gray-200 dark:bg-gray-800\"></div>\n\n    <div>\n      <p class=\"text-theme-xs mb-1 text-center text-gray-500 sm:text-sm dark:text-gray-400\">Выручка</p>\n      <p class=\"flex items-center justify-center gap-1 text-base font-semibol