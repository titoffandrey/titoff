ng-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30\" autocomplete=\"username\" required=\"\" autofocus=\"\">\n                    </div>\n                    \n                    <div>\n                      <label class=\"mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400\" for=\"admin-password\">Пароль</label>\n                      <div class=\"relative\">\n                        <input placeholder=\"Пароль\" class=\"dark:bg-dark-900 shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent py-2.5 ps-4 pe-11 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30\" type=\"password\" id=\"admin-password\" name=\"password\" autocomplete=\"current-password\" required=\"\">\n                        \n                      </div>\n                    </div>\n                    \n                    \n                    \n                    <div>\n                      <button class=\"bg-brand-500 shadow-theme-xs hover:bg-brand-600 flex w-full items-center justify-center rounded-lg px-4 py-3 text-sm font-medium text-white transition\" type=\"submit\">Войти</button>\n                    </div>\n                  </div>\n                </form>\n                \n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"bg-brand-950 relative hidden h-full w-full items-center lg:grid lg:w-1/2 dark:bg-white/5\">\n          <div class=\"z-1 flex items-center justify-center\">\n            \n            <div class=\"absolute top-0 right-0 -z-1 w-full max-w-[250px] xl:max-w-[450px] rtl:right-auto rtl:left-0 rtl:-scale-x-100\">\n  <img src=\"/static/tailadmin-grid.svg\" alt=\"\">\n</div>\n<div class=\"absolute bottom-0 left-0 -z-1 w-full max-w-[250px]